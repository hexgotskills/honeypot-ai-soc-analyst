# Copy this file to .env and fill in your values. Never commit .env.
DATABASE_PATH=data/soc.db
AI_PROVIDER=mock
# Set to "gemini" to use the real API
AI_API_KEY=
# Model name passed to the Gemini API
AI_MODEL=gemini-2.5-flash-lite

# Bind address for decoy services and dashboard (127.0.0.1 for local, or lab IP like 10.x.x.x / 192.168.x.x)
DECOY_BIND_HOST=127.0.0.1
DASHBOARD_HOST=127.0.0.1

